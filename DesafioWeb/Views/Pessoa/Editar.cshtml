@model DesafioWeb.Models.PessoaModel

@{
    ViewData["Title"] = "Editar Pessoa";
}

<h2>Editar Pessoa</h2>

@if (ViewBag.Erro != null)
{
    <div class="alert alert-danger">
        @ViewBag.Erro
    </div>
}

<form asp-action="Editar" method="post">

    <input asp-for="Id" type="hidden"/>

    <input type="hidden"
           name="pessoaId"
           value="@Model.Id"/>

    <h4>Dados da Pessoa</h4>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">
            Nome
        </label>

        <input asp-for="Nome"
               class="form-control"
               minlength="2"/>

        <span asp-validation-for="Nome"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CPF" class="form-label">CPF</label>
        <input asp-for="CPF" class="form-control"
               maxlength="11"
               minlength="11"/>
    </div>

    <div class="mb-3">
        <label asp-for="DataNascimento" class="form-label">
            Data de Nascimento
        </label>

        <input asp-for="DataNascimento"
               type="date"
               class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control"/>
    </div>

    <hr />

    <hr />

    <h4>Telefones</h4>

    @if (Model.Telefones != null && Model.Telefones.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>DDD</th>
                    <th>Número</th>
                    <th>Tipo</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < Model.Telefones.Count; i++)
                {
                    var telefone = Model.Telefones[i];

                    <input asp-for="Telefones[i].Id" type="hidden" />
                    <input asp-for="Telefones[i].PessoaId" type="hidden" />
                    <input asp-for="Telefones[i].DDD" type="hidden" />
                    <input asp-for="Telefones[i].Numero" type="hidden" />
                    <input asp-for="Telefones[i].Tipo" type="hidden" />

                    <tr>
                        <td>@telefone.DDD</td>

                        <td>@telefone.Numero</td>

                        <td>@telefone.Tipo</td>

                        <td>
                            <a asp-controller="Pessoa"
                               asp-action="EditarTelefone"
                               asp-route-id="@telefone.Id"
                               class="btn btn-sm btn-warning"
                                data-bs-toggle="tooltip"
                                data-bs-placement="top"
                                title="Editar telefone">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="Excluir telefone"
                                    formaction="@Url.Action("DeletarTelefone", "Pessoa")"
                                    formmethod="post"
                                    name="telefoneId"
                                    value="@telefone.Id"
                                    onclick="return confirm('Tem certeza que deseja excluir este telefone?');">
                                    <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Nenhum telefone cadastrado.</p>
    }

    <a asp-controller="Pessoa"
       asp-action="CriarTelefone"
       asp-route-pessoaId="@Model.Id"
       class="btn btn-primary"
       data-bs-toggle="tooltip"
       data-bs-placement="top"
       title="Adicionar telefone">
       <i class="bi bi-telephone-plus"></i>
    </a>

    <h4>Endereços</h4>

    @if (Model.Enderecos != null && Model.Enderecos.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>CEP</th>
                    <th>Logradouro</th>
                    <th>Número</th>
                    <th>Bairro</th>
                    <th>Cidade</th>
                    <th>UF</th>
                    <th class="text-center">Principal</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < Model.Enderecos.Count; i++)
                {
                    var endereco = Model.Enderecos[i];

                    <input asp-for="Enderecos[i].Id" type="hidden" />
                    <input asp-for="Enderecos[i].PessoaId" type="hidden" />
                    <input asp-for="Enderecos[i].CEP" type="hidden" />
                    <input asp-for="Enderecos[i].Logradouro" type="hidden" />
                    <input asp-for="Enderecos[i].Numero" type="hidden" />
                    <input asp-for="Enderecos[i].Complemento" type="hidden" />
                    <input asp-for="Enderecos[i].Bairro" type="hidden" />
                    <input asp-for="Enderecos[i].Cidade" type="hidden" />
                    <input asp-for="Enderecos[i].Estado" type="hidden" />
                    <input asp-for="Enderecos[i].IsPrincipal" type="hidden" />

                    <tr>
                        <td>@endereco.CEP</td>

                        <td>@endereco.Logradouro</td>

                        <td>@endereco.Numero</td>

                        <td>@endereco.Bairro</td>

                        <td>@endereco.Cidade</td>

                        <td>@endereco.Estado</td>

                        <td class="text-center align-middle">
                            @if (endereco.IsPrincipal)
                            {
                                <span class="badge bg-success" style="color: white !important; display: inline-flex; align-items: center; justify-content: center;">
                                    &#x2713;
                                </span>
                            }
                        </td>


                        <td>
                            <a asp-controller="Pessoa"
                               asp-action="EditarEndereco"
                               asp-route-id="@endereco.Id"
                               class="btn btn-sm btn-warning"
                               data-bs-toggle="tooltip"
                               data-bs-placement="top"
                               title="Editar endereço">
                               <i class="bi bi-pencil-square"></i>
                            </a>

                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="Excluir endereço"
                                    formaction="@Url.Action("DeletarEndereco", "Pessoa")"
                                    formmethod="post"
                                    name="enderecoId"
                                    value="@endereco.Id"
                                    onclick="return confirm('Tem certeza que deseja excluir este endereço?');">
                                    <i class="bi bi-trash"></i>
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>Nenhum endereço cadastrado.</p>
    }

    <a asp-controller="Pessoa"
       asp-action="CriarEndereco"
       asp-route-pessoaId="@Model.Id"
       class="btn btn-primary"
       data-bs-toggle="tooltip"
       data-bs-placement="top"
       title="Adicionar endereço">
       <i class="bi bi-house-add"></i>
    </a>

    <hr />

    <button type="submit" class="btn btn-success">
        Salvar Alterações
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a> 
</form>