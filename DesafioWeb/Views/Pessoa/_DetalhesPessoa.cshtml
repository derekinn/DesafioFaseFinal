@model DesafioWeb.Models.PessoaModel

<div class="row">

    <div class="col-md-6">
        <strong>Nome:</strong>
        <p>@Model.Nome</p>
    </div>

    <div class="col-md-6">
        <strong>CPF:</strong>
        <p>@Model.CPF</p>
    </div>

</div>

<div class="row">

    <div class="col-md-6">
        <strong>Data de Nascimento:</strong>
        <p>@Model.DataNascimento.ToString("dd/MM/yyyy")</p>
    </div>

    <div class="col-md-6">
        <strong>Email:</strong>
        <p>@Model.Email</p>
    </div>

</div>

<hr />

<h5>Telefones</h5>

@if (Model.Telefones != null && Model.Telefones.Any())
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>DDD</th>
                <th>Número</th>
                <th>Tipo</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var telefone in Model.Telefones)
            {
                <tr>
                    <td>@telefone.DDD</td>
                    <td>@telefone.Numero</td>
                    <td>@telefone.Tipo</td>
                </tr>
            }

        </tbody>

    </table>
}
else
{
    <p>Nenhum telefone cadastrado.</p>
}

<hr />

<h5>Endereços</h5>

@if (Model.Enderecos != null && Model.Enderecos.Any())
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>CEP</th>
                <th>Logradouro</th>
                <th>Número</th>
                <th>Complemento</th>
                <th>Bairro</th>
                <th>Cidade</th>
                <th>UF</th>
                <th>Principal</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var endereco in Model.Enderecos)
            {
                <tr>
                    <td>@endereco.CEP</td>
                    <td>@endereco.Logradouro</td>
                    <td class="text-center align-middle">@endereco.Numero</td>
                    <td>@endereco.Complemento</td>
                    <td>@endereco.Bairro</td>
                    <td>@endereco.Cidade</td>
                    <td>@endereco.Estado</td>

                    <td class="text-center align-middle">
                        @if (endereco.IsPrincipal)
                        {
                            <span class="badge bg-success" style="color: white !important; display: inline-flex; align-items: center; justify-content: center;">
                                &#x2713;
                            </span>
                        }
                    </td>

                </tr>
            }

        </tbody>

    </table>
}
else
{
    <p>Nenhum endereço cadastrado.</p>
}