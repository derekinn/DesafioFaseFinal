@model DesafioWeb.Models.PessoaModel
@using Desafio.Models

@{
    ViewData["Title"] = "Nova Pessoa";
}

<h2>Nova Pessoa</h2>

@if (ViewBag.Erro != null)
{
    <div class="alert alert-danger">
        @ViewBag.Erro
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <strong>Erros do formulário:</strong>

        <ul>
            @foreach (var erro in ViewData.ModelState.Values
                .SelectMany(v => v.Errors))
            {
                <li>@erro.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-action="Criar" method="post">

    <h4>Dados da Pessoa</h4> 

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">
            Nome Completo
        </label>

        <input asp-for="Nome"
               class="form-control"
               minlength="2"
               placeholder="Insira o nome"/>

        <span asp-validation-for="Nome"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CPF" class="form-label">CPF</label>
        <input asp-for="CPF" class="form-control"
               maxlength="11"
               minlength="11"
               placeholder="Insira o CPF" />

        <span asp-validation-for="CPF" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DataNascimento" class="form-label">
            Data de Nascimento
        </label>

        <input asp-for="DataNascimento"
               type="date"
               class="form-control"/>

        <span asp-validation-for="DataNascimento"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" inputmode="email" placeholder="nome@email.com"/>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <hr />

    <h4>Telefone</h4>

    <div class="mb-3">
        <label asp-for="Telefones[0].DDD" class="form-label">
            DDD
        </label>

        <input asp-for="Telefones[0].DDD"
               class="form-control"
               maxlength="3"
               placeholder="Insira o DDD"/>

        <span asp-validation-for="Telefones[0].DDD"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefones[0].Numero" class="form-label">
            Número
        </label>

        <input asp-for="Telefones[0].Numero" 
               class="form-control"
               maxlength="9"
               placeholder="Insira o número"/>

        <span asp-validation-for="Telefones[0].Numero"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefones[0].Tipo" class="form-label">
            Tipo
        </label>
        <select asp-for="Telefones[0].Tipo"
                class="form-select">
            <option value="">Selecione o Tipo</option>
            <option value="Pessoal">Pessoal</option>
            <option value="Comercial">Comercial</option>
            <option value="Whatsapp">Whatsapp</option>
        </select>

        <span asp-validation-for="Telefones[0].Tipo"
              class="text-danger"></span>
    </div>

    <button type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#modalNovoTelefone"
            title="Adicionar telefone">
        <i class="bi bi-telephone-plus"></i>
    </button>

    <hr />

    <h4>Endereço</h4>

    <div class="mb-3">
        <label asp-for="Enderecos[0].CEP" class="form-label">
            CEP
        </label>

        <input asp-for="Enderecos[0].CEP"
               class="form-control"
               maxlength="8"
               placeholder="Insira o CEP"/>
    </div>

    <div class="mb-3">
        <label asp-for="Enderecos[0].Logradouro" class="form-label">
            Logradouro
        </label>

        <input asp-for="Enderecos[0].Logradouro"
               class="form-control"
               placeholder="Insira o Logradouro"/>
    </div>

    <div class="mb-3">
        <label asp-for="Enderecos[0].Numero" class="form-label">
            Número
        </label>

        <input asp-for="Enderecos[0].Numero"
               class="form-control"
               placeholder="Insira número"/>
    </div>

    <div class="mb-3">
        <label asp-for="Enderecos[0].Complemento" class="form-label">
            Complemento
        </label>

        <input asp-for="Enderecos[0].Complemento"
               class="form-control"
               placeholder="Insira o complemento"/>
    </div>

    <div class="mb-3">
        <label asp-for="Enderecos[0].Bairro" class="form-label">
            Bairro
        </label>

        <input asp-for="Enderecos[0].Bairro"
               class="form-control" 
               placeholder="Insira o bairro"/>
    </div>

    <div class="mb-3">
        <label asp-for="Enderecos[0].Cidade" class="form-label">
            Cidade
        </label>

        <input asp-for="Enderecos[0].Cidade"
               class="form-control"
               placeholder="Insira a cidade"/>
    </div>

    <label asp-for="Enderecos[0].Estado" class="form-label">
        Estado
    </label>

    <select asp-for="Enderecos[0].Estado"
            class="form-select">

        <option value="">Selecione o Estado</option>

        @foreach (var uf in UF.ListaUF)
        {
            <option value="@uf.Sigla"> @uf.Sigla - @uf.Nome</option>
        }

    </select>

    <span asp-validation-for="Enderecos[0].Estado"
          class="text-danger"></span>

    <div class="form-check mb-3">
        <input asp-for="Enderecos[0].IsPrincipal"
               class="form-check-input" />

        <label asp-for="Enderecos[0].IsPrincipal"
               class="form-check-label">
            Endereço principal
        </label>
    </div>
    <div class="mb3">
        <a asp-controller="Pessoa"
           asp-action="CriarEndereco"
           asp-route-pessoaId="@Model.Id"
           class="btn btn-primary"
           data-bs-toggle="tooltip"
           data-bs-placement="top"
           title="Adicionar endereço">
            <i class="bi bi-house-add"></i>
        </a>
    </div>
    <hr />

    <div class="modal fade"
         id="modalNovoTelefone"
         tabindex="-1"
         aria-labelledby="modalNovoTelefoneLabel"
         aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalNovoTelefoneLabel">
                        Adicionar telefone
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Fechar">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">
                            DDD
                        </label>

                        <input type="text"
                               id="NovoTelefoneDDD"
                               class="form-control"
                               maxlength="3"
                               placeholder="Ex.: 32" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Número
                        </label>

                        <input type="text"
                               id="NovoTelefoneNumero"
                               class="form-control"
                               maxlength="9"
                               placeholder="Ex.: 999999999" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Tipo
                        </label>

                        <select id="NovoTelefoneTipo"
                                class="form-select">

                            <option value="">
                                Selecione o tipo
                            </option>

                            <option value="Pessoal">
                                Pessoal
                            </option>

                            <option value="Comercial">
                                Comercial
                            </option>

                            <option value="Whatsapp">
                                Whatsapp
                            </option>

                        </select>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="button"
                            class="btn btn-success"
                            onclick="AdicionarTelefone()">
                        Adicionar
                    </button>

                </div>

            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success">
        Salvar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
