@model DesafioWeb.Models.PessoaModel
@using Desafio.Models

@{
    ViewData["Title"] = "Nova Pessoa";
}

<h2>Nova Pessoa</h2>

@if (ViewBag.Erro != null)
{
    <div class="alert alert-danger">@ViewBag.Erro</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <strong>Erros do formulário:</strong>

        <ul>
            @foreach (var erro in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@erro.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-action="Criar" method="post">

    <h4 class="mt-3">Dados da Pessoa</h4>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome Completo</label>

        <input asp-for="Nome" class="form-control" minlength="2" placeholder="Insira o nome" />

        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CPF" class="form-label">CPF</label>

        <input asp-for="CPF" class="form-control" maxlength="11" minlength="11" placeholder="Insira o CPF" />

        <span asp-validation-for="CPF" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DataNascimento" class="form-label">Data de Nascimento</label>

        <input asp-for="DataNascimento" type="date" class="form-control" />

        <span asp-validation-for="DataNascimento" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" inputmode="email" placeholder="nome@email.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <hr />

    <h4>Lista de Telefones</h4>

    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>DDD</th>
                    <th>Número</th>
                    <th>Tipo</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="listaTelefones">
            </tbody>
        </table>
    </div>

    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNovoTelefone">
        <i class="bi bi-telephone-plus"> Adicionar telefone</i>
    </button>

    <hr />

    <h4>Lista de Endereços</h4>

    <div class="table-responsive">
        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>CEP</th>
                    <th>Logradouro</th>
                    <th>Número</th>
                    <th>Complemento</th>
                    <th>Bairro</th>
                    <th>Cidade</th>
                    <th>Estado</th>
                    <th>Endereço Principal</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody id="listaEnderecos">
            </tbody>
        </table>
    </div>

    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNovoEndereco">
        <i class="bi bi-telephone-plus"> Adicionar endereço</i>
    </button>

    <hr />

    <div class="modal fade" id="modalNovoTelefone" tabindex="-1" aria-labelledby="modalNovoTelefoneLabel" aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalNovoTelefoneLabel"> Adicionar telefone</h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">
                            DDD
                        </label>

                        <input type="text" id="NovoTelefoneDDD" class="form-control" maxlength="3" placeholder="Coloque o DDD" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Número
                        </label>

                        <input type="text" id="NovoTelefoneNumero" class="form-control" maxlength="9" placeholder="Coloque o número" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Tipo
                        </label>

                        <select id="NovoTelefoneTipo" class="form-select">

                            <option value="">Selecione o tipo</option>

                            <option value="Pessoal">Pessoal</option>

                            <option value="Comercial">Comercial</option>

                            <option value="Whatsapp">Whatsapp</option>

                        </select>
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-success" onclick="AdicionarTelefone()">Adicionar</button>

                    <button type="button"class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalNovoEndereco" tabindex="-1" aria-labelledby="modalNovoEnderecoLabel" aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalNovoEnderecoLabel">Adicionar Endereco</h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">CEP</label>

                        <input type="text" id="NovoEnderecoCEP" class="form-control" maxlength="8" placeholder="Coloque o CEP" /></div>

                    <div class="mb-3">
                        <label class="form-label">Logradouro</label>

                        <input type="text" id="NovoEnderecoLogradouro" class="form-control" placeholder="Coloque o logradouro" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Número</label>

                        <input type="text" id="NovoEnderecoNumero" class="form-control" placeholder="Coloque o número" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Complemento</label>

                        <input type="text" id="NovoEnderecoComplemento" class="form-control" placeholder="Coloque o complemento" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Bairro</label>

                        <input type="text" id="NovoEnderecoBairro" class="form-control" placeholder="Coloque o bairro" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cidade</label>

                        <input type="text" id="NovoEnderecoCidade" class="form-control" placeholder="Coloque a cidade" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Estado</label>

                        <select id="NovoEnderecoEstado" class="form-select">

                            <option value="">Selecione o Estado</option>

                            @foreach (var uf in UF.ListaUF)
                            {
                                <option value="@uf.Sigla"> @uf.Sigla - @uf.Nome</option>
                            }

                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="NovoEnderecoIsPrincipal" class="form-check-label">Endereço Principal</label>

                        <input type="checkbox" id="NovoEnderecoIsPrincipal" class="form-check-input" />
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-success" onclick="AdicionarEndereco()">Adicionar</button>

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success">Salvar</button>

    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const CampoNome = document.getElementById("Nome");

        if (CampoNome) {
            CampoNome.addEventListener("input", function() {
                this.value = this.value.replace(/[0-9]/g, "");
            });
        }

        function AdicionarTelefone() {
            const ddd = document.getElementById("NovoTelefoneDDD").value;
            const numero = document.getElementById("NovoTelefoneNumero").value;
            const tipo = document.getElementById("NovoTelefoneTipo").value;
            const campos = [ddd, numero, tipo];

            if (campos.some(campo => campo ==="")) {
                alert("Preencha todos os campos do telefone!");
                return;
            }

            const listaTelefones =
                document.getElementById("listaTelefones");

            const indice = Date.now();

            const linha = document.createElement("tr");

            linha.className = "telefone-item";

            linha.innerHTML = `
                                <td>${ddd}</td>
                                <td>${numero}</td>
                                <td>${tipo}</td>

                                <td>
                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            onclick="RemoverTelefone(this)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>

                                <input type="hidden"
                                       name="Telefones.Index"
                                       value="${indice}" />

                                <input type="hidden"
                                       name="Telefones[${indice}].DDD"
                                       value="${ddd}" />

                                <input type="hidden"
                                       name="Telefones[${indice}].Numero"
                                       value="${numero}" />

                                <input type="hidden"
                                       name="Telefones[${indice}].Tipo"
                                       value="${tipo}" />
                            `;

            listaTelefones.appendChild(linha);

            const elementoModal =
                document.getElementById("modalNovoTelefone");

            const modal =
                bootstrap.Modal.getInstance(elementoModal);

            if (modal) {
                modal.hide();
            }

            document.getElementById("NovoTelefoneDDD").value = "";
            document.getElementById("NovoTelefoneNumero").value = "";
            document.getElementById("NovoTelefoneTipo").value = "";
        }

        function AdicionarEndereco() {
            const cep = document.getElementById("NovoEnderecoCEP").value;
            const logradouro = document.getElementById("NovoEnderecoLogradouro").value;
            const numero = document.getElementById("NovoEnderecoNumero").value;
            const complemento = document.getElementById("NovoEnderecoComplemento").value;
            const bairro = document.getElementById("NovoEnderecoBairro").value;
            const cidade = document.getElementById("NovoEnderecoCidade").value;
            const estado = document.getElementById("NovoEnderecoEstado").value;
            const isprincipal = document.getElementById("NovoEnderecoIsPrincipal").value;
            const campos = [cep, logradouro, numero, complemento, bairro, cidade, estado];

            if (campos.some(campo => campo === "")) {
                alert("Preencha todos os campos do endereço!");
                return;
            }

            const listaEnderecos =
                document.getElementById("listaEnderecos");

            const indice = Date.now();

            const linha = document.createElement("tr");

            linha.className = "endereco-item";

            linha.innerHTML = `
                                <td>${cep}</td>
                                <td>${logradouro}</td>
                                <td>${numero}</td>
                                <td>${complemento}</td>
                                <td>${bairro}</td>
                                <td>${cidade}</td>
                                <td>${estado}</td>
                                <td>${isprincipal}</td>

                                <td>
                                   <button type="button" class="btn btn-danger btn-sm" onclick="RemoverEndereco(this)"><i class="bi bi-trash"></i></button>
                                </td>

                                <input type="hidden" name="Telefones.Index" value="${indice}" />
                                <input type="hidden" name="Telefones[${indice}].CEP" value="${cep}" />
                                <input type="hidden" name="Telefones[${indice}].Logradouro" value="${logradouro}" />
                                <input type="hidden" name="Telefones[${indice}].Numero" value="${numero}" />
                                <input type="hidden" name="Telefones[${indice}].Complemento" value="${complemento}" />
                                <input type="hidden" name="Telefones[${indice}].Bairro" value="${bairro}" />
                                <input type="hidden" name="Telefones[${indice}].Cidade" value="${cidade}" />
                                <input type="hidden" name="Telefones[${indice}].Estado" value="${estado}" />
                                <input type="hidden" name="Telefones[${indice}].IsPrincipal" value="${isprincipal}" />
                                    `;

            listaEnderecos.appendChild(linha);

            const elementoModal =
                document.getElementById("modalNovoEndereco");

            const modal =
                bootstrap.Modal.getInstance(elementoModal);

            if (modal) {
                modal.hide();
            }

            document.getElementById("NovoEnderecoCEP").value = "";
            document.getElementById("NovoEnderecoLogradouro").value = "";
            document.getElementById("NovoEnderecoNumero").value = "";
            document.getElementById("NovoEnderecoComplemento").value = "";
            document.getElementById("NovoEnderecoBairro").value = "";
            document.getElementById("NovoEnderecoCidade").value = "";
            document.getElementById("NovoEnderecoEstado").value = "";
            document.getElementById("NovoEnderecoIsPrincipal").value = "";
        }

        function RemoverTelefone(botao) {
            botao.closest("tr").remove();
        }

        function RemoverEndereco(botao) {
            botao.closest("tr").remove();
        }
    </script>
}