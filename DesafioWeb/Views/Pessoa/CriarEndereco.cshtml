@model DesafioWeb.Models.EnderecoModel
@using Desafio.Models

@{
    ViewData["Title"] = "Novo Endereço";
}

<h2>Novo Endereço</h2>

@if (ViewBag.Erro != null)
{
    <div class="alert alert-danger">
        @ViewBag.Erro
    </div>
}

<form asp-action="CriarEndereco" method="post">

    <input asp-for="PessoaId" type="hidden" />

    <div class="mb-3">
        <label asp-for="CEP" class="form-label">
            CEP
        </label>

        <input asp-for="CEP"
               class="form-control"
               maxlength="8"
               minlength="8"/>

        <span asp-validation-for="CEP"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Logradouro" class="form-label">
            Logradouro
        </label>

        <input asp-for="Logradouro"
               class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="Numero" class="form-label">
            Número
        </label>

        <input asp-for="Numero"
               class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="Complemento" class="form-label">
            Complemento
        </label>

        <input asp-for="Complemento"
               class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="Bairro" class="form-label">
            Bairro
        </label>

        <input asp-for="Bairro"
               class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="Cidade" class="form-label">
            Cidade
        </label>

        <input asp-for="Cidade"
               class="form-control"/>
    </div>

    <div class="mb-3">
        <label asp-for="Estado" class="form-label">
            Estado
        </label>

        <select asp-for="Estado"
                class="form-select">

            <option value="">Selecione</option>

            @foreach (var uf in UF.ListaUF)
            {
                <option value="@uf.Sigla"> @uf.Sigla - @uf.Nome</option>
            }

        </select>

        <span asp-validation-for="Estado"
              class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsPrincipal"
               class="form-check-input"/>

        <label asp-for="IsPrincipal"
               class="form-check-label">
            Endereço principal
        </label>
    </div>

    <button type="submit" class="btn btn-success">
        Salvar
    </button>

    <a asp-action="Editar"
       asp-route-id="@Model.PessoaId"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>